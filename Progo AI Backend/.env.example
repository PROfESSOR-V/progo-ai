# ============================================
# Progo AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ============================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx

# Pinecone API Key (get from https://app.pinecone.io)
PINECONE_API_KEY=pcsk_xxxxxxxxxxxx

# Pinecone index name (default: ragtest)
PINECONE_INDEX=ragtest

# Pinecone index host (leave empty for auto-detect)
PINECONE_INDEX_HOST=

# Server port (default: 8080)
PORT=8080

# RAG Pipeline paths (adjust to your local setup)
RAG_PYTHON_PATH=/path/to/your/venv/bin/python
RAG_SCRIPT_PATH=/path/to/your/main.py
RAG_DATA_DIR=/path/to/your/data
